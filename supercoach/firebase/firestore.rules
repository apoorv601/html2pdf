rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user can only ever read/write their own document tree.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
